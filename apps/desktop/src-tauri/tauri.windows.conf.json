{
  "build": {
    "beforeBuildCommand": "pnpm run build:vite && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-local-mcp-windows.ps1",
    "beforeDevCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-local-mcp-windows.ps1 && pnpm run dev:vite"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ThingMaker",
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 600,
      "resizable": true,
      "titleBarStyle": "Visible",
      "hiddenTitle": false,
      "trafficLightPosition": null
    }]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../dist-remote/": "remote-ui/",
      "../dist-local-mcp/": "local-mcp-runtime/"
    }
  }
}
