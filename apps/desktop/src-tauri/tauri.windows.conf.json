{
  "build": {
    "beforeBuildCommand": "pnpm run build:vite && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-web-windows.ps1",
    "beforeDevCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-web-windows.ps1 && pnpm run dev:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThingMaker",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "trafficLightPosition": null
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "resources": {
      "../dist-remote/": "remote-ui/",
      "../dist-web/node_modules/": "web-runtime/node_modules/",
      "../dist-web/browsers/": "web-runtime/browsers/",
      "../dist-web/node.exe": "web-runtime/node.exe",
      "../dist-web/session.mjs": "web-runtime/session.mjs",
      "../dist-web/package.json": "web-runtime/package.json",
      "../dist-web/package-lock.json": "web-runtime/package-lock.json",
      "../dist-web/NODE-LICENSE.txt": "web-runtime/NODE-LICENSE.txt"
    }
  }
}
