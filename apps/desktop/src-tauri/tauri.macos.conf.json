{
  "build": {
    "beforeBuildCommand": "pnpm run build:vite && bash ../../scripts/prepare-web-macos.sh",
    "beforeDevCommand": "bash ../../scripts/prepare-web-macos.sh && pnpm run dev:vite"
  },
  "bundle": {
    "resources": {
      "../dist-web/node_modules/": "web-runtime/node_modules/",
      "../dist-web/browsers/": "web-runtime/browsers/",
      "../dist-web/node": "web-runtime/node",
      "../dist-web/session.mjs": "web-runtime/session.mjs",
      "../dist-web/package.json": "web-runtime/package.json",
      "../dist-web/package-lock.json": "web-runtime/package-lock.json",
      "../dist-web/NODE-LICENSE.txt": "web-runtime/NODE-LICENSE.txt",
      "../dist-web/lent-document.mjs": "web-runtime/lent-document.mjs",
      "../dist-web/tools.json": "web-runtime/tools.json",
      "../dist-web/public-network.mjs": "web-runtime/public-network.mjs"
    }
  }
}
